# Base URL des assets (vide = origine locale /public)
# Exemple R2 plus tard : https://cdn.mskcreation.ml
VITE_ASSET_BASE_URL=

# Origine absolue du site (canonical / hreflang / og:image / JSON-LD / sitemap)
# Local :
VITE_SITE_ORIGIN=http://localhost:5173
# Prod (obligatoire au déploiement) — remplacer par le domaine réel :
# VITE_SITE_ORIGIN=https://www.mskcreation.net
# Gate : npm run check:origin -- --strict  (échoue si localhost)

# Contact e-mail (Q23) — laisser désactivé jusqu’au provider validé
# CONTACT_EMAIL_ENABLED=1
# RESEND_API_KEY=
# CONTACT_EMAIL_TO=contact@mskcreation.net
# CONTACT_EMAIL_FROM=MSK Création <noreply@mskcreation.net>
