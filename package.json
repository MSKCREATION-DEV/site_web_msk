{
  "name": "site-web-msk",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "check:copy": "node scripts/check-copy-dashes.mjs",
    "check:images": "node scripts/check-image-weights.mjs",
    "assets:compress": "node scripts/compress-assets.mjs",
    "assets:compress:priority": "node scripts/compress-assets.mjs --only=hero,works,team,cta,contact,approach",
    "assets:mockup": "node scripts/compose-device-mockups.mjs",
    "assets:stamp-meta": "node scripts/stamp-image-metadata.mjs",
    "check": "npm run typecheck && npm run check:copy"
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "daisyui": "^5.7.44",
    "isbot": "^5.1.36",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  },
  "description": "MSK Création — site vitrine React Router SSR"
}
